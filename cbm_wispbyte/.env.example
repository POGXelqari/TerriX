# ==============================================================================
# CBM Wispbyte Runtime Environment Variables
# ==============================================================================

# Wispbyte Server Allocation
PORT=10093
SERVER_PORT=10093
WISPBYTE_SERVER_URL=http://78.154.103.45:10093/
WISPBYTE_SUBDOMAIN=cbm.wispbyte.org
CBM_POLL_INTERVAL=30.0

# Master Symmetric Encryption & HMAC Key
# 32-byte URL-safe base64 string: python -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
CBM_ENCRYPTION_KEY=your_base64_32byte_master_encryption_key_here

# OpenID Connect (OIDC) SSO Configuration
OIDC_ENABLED=true
OIDC_ISSUER_URL=https://accounts.google.com
OIDC_CLIENT_ID=your-client-id.apps.googleusercontent.com
OIDC_CLIENT_SECRET=GOCSPX-your-client-secret-here
OIDC_REDIRECT_URI=https://cbm.wispbyte.org/api/auth/oidc/callback
OIDC_SCOPES=openid email profile

# Virtual API Credit Metering Policy
CREDIT_PER_REQUEST_DEFAULT=100
CREDIT_IDEMPOTENCY_WINDOW_SECONDS=86400

# Cloudflare Tunnel Configuration
# Optional: Set your Cloudflare Named Tunnel token from the Zero Trust Dashboard.
# If omitted or blank, CBM automatically establishes a Cloudflare Quick Tunnel (*.trycloudflare.com).
ENABLE_CLOUDFLARE_TUNNEL=true
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here
CLOUDFLARE_TUNNEL_PROTOCOL=http2 # 'http2' (recommended for containers/VPS to avoid idle UDP/QUIC timeouts) or 'quic'

# Territorial.io Vault Credentials
CBM_VAULT_ACCOUNT=DdcBC
CBM_VAULT_PASSWORD=your_territorial_vault_password_here

# Supabase PostgreSQL Configuration (Optional: falls back to local SQLite if blank)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_service_role_key_here

# NVIDIA AI NIM Configuration
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TIMEOUT=45.0
CREDIT_PER_AI_REQUEST=10

# Discord AutoMod & Egress Proxy Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_APPLICATION_ID=your_discord_app_id_here
DISCORD_COOLDOWN_SECONDS=90000
# Optional Outbound Proxy to route around shared host IP rate limits (HTTP or SOCKS5):
# DISCORD_PROXY_URL=http://username:password@proxy-host:port
# DISCORD_PROXY_URL=socks5://username:password@proxy-host:port

