# ==============================================================================
# CBM Wispbyte Runtime Environment Variables
# ==============================================================================

# Wispbyte Server Allocation
PORT=10093
SERVER_PORT=10093
WISPBYTE_SERVER_URL=http://78.154.103.45:10093/
WISPBYTE_SUBDOMAIN=cbm.wispbyte.org
CBM_POLL_INTERVAL=30.0

# Cloudflare Tunnel Configuration
# Optional: Set your Cloudflare Named Tunnel token from the Zero Trust Dashboard.
# If omitted or blank, CBM automatically establishes a Cloudflare Quick Tunnel (*.trycloudflare.com).
ENABLE_CLOUDFLARE_TUNNEL=true
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here
CLOUDFLARE_TUNNEL_PROTOCOL=http2 # 'http2' (recommended for containers/VPS to avoid idle UDP/QUIC timeouts) or 'quic'

# Territorial.io Vault Credentials
CBM_VAULT_ACCOUNT=DdcBC
CBM_VAULT_PASSWORD=your_territorial_vault_password_here

# Supabase PostgreSQL Configuration (Optional: falls back to local SQLite if blank)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_service_role_key_here
