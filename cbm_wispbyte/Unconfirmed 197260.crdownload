<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>SQLite Editor</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/sql.js/1.8.0/sql-wasm.js"></script>
<style>
*{box-sizing:border-box;margin:0;padding:0;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,sans-serif}
body{display:flex;height:100vh;background:#0f172a;color:#e2e8f0;overflow:hidden}
#sb{width:220px;background:#1e293b;border-right:1px solid #334155;display:flex;flex-direction:column}
#mn{flex:1;display:flex;flex-direction:column;min-width:0}
.bar{padding:8px 12px;background:#1e293b;border-bottom:1px solid #334155;display:flex;gap:8px;align-items:center}
button,.btn{padding:5px 10px;background:#3b82f6;color:#fff;border:none;border-radius:4px;cursor:pointer;font-size:12px;font-weight:600}
button:hover,.btn:hover{background:#2563eb}
.btn-sc{background:#334155}.btn-sc:hover{background:#475569}
input[type="file"]{display:none}
#tl{flex:1;overflow-y:auto;padding:8px;display:flex;flex-direction:column;gap:4px}
.ti{padding:6px 8px;border-radius:4px;cursor:pointer;font-size:13px;color:#cbd5e1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.ti:hover{background:#334155;color:#fff}
#qe{height:120px;background:#0b1120;color:#f8fafc;padding:10px;border:none;outline:none;font-family:ui-monospace,monospace;font-size:13px;resize:none;border-bottom:1px solid #334155}
#out{flex:1;overflow:auto;position:relative}
table{border-collapse:collapse;width:100%;font-size:12px;font-family:ui-monospace,monospace}
th,td{border:1px solid #334155;padding:6px 10px;text-align:left;white-space:nowrap;max-width:300px;overflow:hidden;text-overflow:ellipsis}
th{background:#1e293b;position:sticky;top:0;z-index:1;color:#93c5fd}
td{background:#0f172a}
td[contenteditable="true"]:focus{outline:2px solid #3b82f6;background:#1e293b}
#msg{padding:8px 12px;font-size:12px;font-family:monospace;background:#0b1120;border-top:1px solid #334155;min-height:32px;display:flex;align-items:center}
.err{color:#f87171}.ok{color:#4ade80}
</style>
</head>
<body>
<div id="sb">
<div class="bar"><span style="font-weight:700;font-size:12px;text-transform:uppercase;letter-spacing:1px;color:#94a3b8">Tables</span></div>
<div id="tl"></div>
</div>
<div id="mn">
<div class="bar">
<label class="btn btn-sc">Open DB<input type="file" id="fi" accept=".db,.sqlite,.sqlite3"></label>
<button class="btn-sc" id="bn">New DB</button>
<button class="btn-sc" id="bx">Export DB</button>
<button id="br">Run (Ctrl+Enter)</button>
</div>
<textarea id="qe" spellcheck="false" placeholder="SELECT * FROM ..."></textarea>
<div id="out"></div>
<div id="msg"></div>
</div>
<script>
let d=null,S=null;
const $=i=>document.getElementById(i),fi=$('fi'),tl=$('tl'),qe=$('qe'),out=$('out'),msg=$('msg');
initSqlJs({locateFile:f=>`https://cdnjs.cloudflare.com/ajax/libs/sql.js/1.8.0/${f}`}).then(s=>{S=s;cD()});
const cD=()=>{if(d)d.close();d=new S.Database();qe.value="CREATE TABLE items (id INTEGER PRIMARY KEY, name TEXT, val REAL);\nINSERT INTO items VALUES (1, 'Sample', 99.5);\nSELECT * FROM items;";eQ();uT()};
const sM=(t,e)=>{msg.className=e?'err':'ok';msg.textContent=t};
const uT=()=>{
tl.innerHTML='';
if(!d)return;
try{
const r=d.exec("SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%' ORDER BY name");
if(r.length&&r[0].values){
r[0].values.forEach(v=>{
const n=v[0],a=document.createElement('div');
a.className='ti';a.textContent=n;
a.onclick=()=>{qe.value=`SELECT * FROM "${n}" LIMIT 100;`;eQ()};
tl.appendChild(a)
})
}
}catch(x){sM(x.message,1)}
};
const eQ=()=>{
if(!d)return;
const q=qe.value.trim();
if(!q)return;
out.innerHTML='';
const t0=performance.now();
try{
const rs=d.exec(q);
const el=performance.now()-t0;
uT();
if(!rs.length){sM(`Query executed successfully in ${el.toFixed(1)}ms. 0 rows returned.`,0);return}
const res=rs[rs.length-1];
const tb=document.createElement('table'),th=document.createElement('thead'),tr=document.createElement('tr');
res.columns.forEach(c=>{const h=document.createElement('th');h.textContent=c;tr.appendChild(h)});
th.appendChild(tr);tb.appendChild(th);
const b=document.createElement('tbody');
res.values.forEach(r=>{
const row=document.createElement('tr');
r.forEach(v=>{const td=document.createElement('td');td.textContent=v===null?'NULL':v;td.contentEditable="true";row.appendChild(td)});
b.appendChild(row)
});
tb.appendChild(b);
out.appendChild(tb);
sM(`Retrieved ${res.values.length} rows in ${el.toFixed(1)}ms.`,0)
}catch(x){sM(x.message,1)}
};
fi.onchange=e=>{
const f=e.target.files[0];
if(!f)return;
const r=new FileReader();
r.onload=()=>{
try{
if(d)d.close();
d=new S.Database(new Uint8Array(r.result));
sM(`Loaded: ${f.name}`,0);
uT();
qe.value="SELECT * FROM sqlite_master WHERE type='table';";
eQ()
}catch(x){sM(x.message,1)}
};
r.readAsArrayBuffer(f)
};
$('bn').onclick=cD;
$('br').onclick=eQ;
$('bx').onclick=()=>{
if(!d)return;
const b=d.export(),a=document.createElement('a');
a.href=URL.createObjectURL(new Blob([b],{type:'application/x-sqlite3'}));
a.download='database.sqlite';
a.click();
URL.revokeObjectURL(a.href)
};
qe.onkeydown=e=>{if((e.ctrlKey||e.metaKey)&&e.key==='Enter'){e.preventDefault();eQ()}};
window.ondragover=e=>e.preventDefault();
window.ondrop=e=>{
e.preventDefault();
if(e.dataTransfer.files.length){fi.files=e.dataTransfer.files;fi.onchange({target:fi})}
};
</script>
</body>
</html>