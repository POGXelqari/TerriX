{
  "name": "terrix-client",
  "version": "1.0.0",
  "description": "TerriX Client - Modern Territorial.io Client built on FXclient architecture",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "node index.js",
    "build-only": "node build.js",
    "build-client": "node build.js --skip-patching",
    "patch": "node build.js --patch-only",
    "test:smoke": "node tests/smoke-test.js",
    "sync:upstream": "node scripts/upstream_checker.js && npm run build && npm run test:smoke"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/POGXelqari/TerriX.git"
  },
  "license": "ISC",
  "dependencies": {
    "core-js": "^3.44.0",
    "js-beautify": "^1.14.11",
    "obscenity": "^0.4.6",
    "uglify-js": "^3.19.2"
  },
  "devDependencies": {
    "@babel/generator": "^8.0.6",
    "@babel/parser": "^8.0.6",
    "@babel/traverse": "^8.0.6",
    "@babel/types": "^8.0.6",
    "playwright": "^1.63.0",
    "webpack": "^5.95.0"
  }
}
