# ==============================================================================
# TerriX Verification Gateway: Vercel Environment Variables
# ==============================================================================
# Configure these variables in your Vercel Project Dashboard:
#   Vercel Dashboard -> Project Settings -> Environment Variables -> Add New
#
# Available CLI commands (requires Vercel CLI linked project):
#   vercel env add SUPABASE_URL production
#   vercel env add SUPABASE_KEY production
#   vercel env add TERRIX_KEY_SALT production
#   vercel env add STAGE_TOKEN_SECRET production
# ==============================================================================

# 1. Supabase Project REST URL
# Base REST API endpoint from Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Secret / Service Role Key
# Found in Project Settings -> API -> Project API Keys -> service_role (secret)
# IMPORTANT: Service role key is required for serverless key insertion & management.
SUPABASE_KEY=your_supabase_service_role_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# 3. Supabase Public Anon Key (Optional for browser client SDKs)
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 4. Cryptographic Key Salt
# Secret high-entropy salt used for deterministic HMAC-SHA256 daily key generation
TERRIX_KEY_SALT=TERRIX_GLOBAL_KEY_SECRET_2026_CHANGE_THIS

# 5. Stage Progression Token Secret
# Used to sign client challenge verification tokens (stage-1 -> stage-2 -> stage-3 -> complete)
STAGE_TOKEN_SECRET=TERRIX_GLOBAL_KEY_SECRET_2026_CHANGE_THIS
