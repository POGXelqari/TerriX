{
  "version": 2,
  "rewrites": [
    { "source": "/", "destination": "/pages/stage-1.html" },
    { "source": "/key", "destination": "/pages/complete.html" },
    { "source": "/verify/stage-1", "destination": "/pages/stage-1.html" },
    { "source": "/verify/stage-2", "destination": "/pages/stage-2.html" },
    { "source": "/verify/stage-3", "destination": "/pages/stage-3.html" },
    { "source": "/verify/complete", "destination": "/pages/complete.html" },
    { "source": "/cbm", "destination": "/pages/cbm.html" },
    { "source": "/cbm.html", "destination": "/pages/cbm.html" },
    { "source": "/bank", "destination": "/pages/cbm.html" },
    { "source": "/rulebook", "destination": "/pages/rulebook.html" },
    { "source": "/rulebook.html", "destination": "/pages/rulebook.html" },
    { "source": "/cbm-logo.png", "destination": "/static/cbm-logo.png" },
    { "source": "/api/cbm/(.*)", "destination": "/api/cbm.py" },
    { "source": "/api/cbm", "destination": "/api/cbm.py" },
    { "source": "/api/verify/(.*)", "destination": "/api/verify.py" },
    { "source": "/api/verify", "destination": "/api/verify.py" },
    { "source": "/api/version", "destination": "/api/verify.py" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, X-Requested-With" }
      ]
    }
  ]
}
